# =============================================================================
# Environment Configuration Example
# =============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Never commit .env.local or any file containing real credentials.
# =============================================================================

# ---------------------------------------------------------------------------
# Provider credentials
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY:
#   - Local: set in .env.local
#   - GitHub Actions: configure as Repository Secret (Settings > Secrets and variables > Actions)
OPENROUTER_API_KEY=

# OPENAI_API_KEY:
#   - Required only if using OpenAI models directly (not through OpenRouter)
#   - Local: set in .env.local
#   - GitHub Actions: configure as Repository Secret
OPENAI_API_KEY=

# ANTHROPIC_API_KEY:
#   - Required only if using Anthropic models directly (not through OpenRouter)
#   - Local: set in .env.local
#   - GitHub Actions: configure as Repository Secret
ANTHROPIC_API_KEY=

# GOOGLE_API_KEY:
#   - Required only if using Google models directly (not through OpenRouter)
#   - Local: set in .env.local
#   - GitHub Actions: configure as Repository Secret
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# OpenCode model routing
# ---------------------------------------------------------------------------
# OPENCODE_MODEL_*:
#   - Local: set in .env.local with values like "deepseek/deepseek-chat-v3-0324"
#   - GitHub Actions: configure as Repository Variables (Settings > Secrets and variables > Actions)
#
# Format: provider/model-name (as recognized by your configured provider)
# Examples:
#   - deepseek/deepseek-chat-v3-0324
#   - anthropic/claude-sonnet-4-20250514
#   - openai/gpt-4o
OPENCODE_MODEL_SIMPLE=
OPENCODE_MODEL_STANDARD=
OPENCODE_MODEL_ADVANCED=

# ---------------------------------------------------------------------------
# Optional: local environment file override
# ---------------------------------------------------------------------------
# ENV_FILE:
#   - Points to a custom .env file path (defaults to .env.local)
#   - Useful for testing different configurations
ENV_FILE=.env.local

# ---------------------------------------------------------------------------
# Database (for local development only)
# ---------------------------------------------------------------------------
# DATABASE_URL:
#   - PostgreSQL connection string for local development
#   - GitHub Actions uses its own test database configured in the workflow
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestaotecnica_dev
