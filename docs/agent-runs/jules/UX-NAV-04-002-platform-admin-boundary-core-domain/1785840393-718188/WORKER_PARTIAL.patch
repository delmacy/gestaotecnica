+import React, { useState, useEffect, useCallback } from 'react';
+import { BuilderPortfolioService } from './workspace-portfolio.service';
+import { BuilderIdentity, BuilderPortfolio, OrganizationPortfolio, PortfolioWorkspace } from './workspace-portfolio.types';
+
+interface UseBuilderPortfolioReturn {
+  identity: BuilderIdentity | null;
+  portfolio: BuilderPortfolio | null;
+  isLoading: boolean;
+  error: string | null;
+  refresh: () => Promise<void>;
+  selectWorkspace: (workspaceId: string) => Promise<void>;
+}
+
+export const useBuilderPortfolio = (userId?: string): UseBuilderPortfolioReturn => {
+  const [identity, setIdentity] = useState<BuilderIdentity | null>(null);
+  const [portfolio, setPortfolio] = useState<BuilderPortfolio | null>(null);
+  const [isLoading, setIsLoading] = useState<boolean>(false);
+  const [error, setError] = useState<string | null>(null);
+  const service = new BuilderPortfolioService();
+
+  const fetchPortfolio = useCallback(async () => {
+    try {
+      setIsLoading(true);
+      setError(null);
+
+      if (userId) {
+        const portfolioData = await service.getBuilderPortfolio(userId);
+        setIdentity(portfolioData.identity);
+        setPortfolio(portfolioData);
+      }
+    } catch (err) {
+      setError(err instanceof Error ? err.message : 'Failed to fetch portfolio');
+    } finally {
+      setIsLoading(false);
+    }
+  }, [userId]);
+
+  const selectWorkspace = useCallback(async (workspaceId: string) => {
+    if (!userId) {
+      setError('User not authenticated');
+      return;
+    }
+
+    try {
+      await service.selectWorkspace(userId, workspaceId);
+      await fetchPortfolio();
+    } catch (err) {
+      setError(err instanceof Error ? err.message : 'Failed to select workspace');
+    }
+  }, [userId, fetchPortfolio]);
+
+  useEffect(() => {
+    if (userId) {
+      fetchPortfolio();
+    }
+  }, [userId, fetchPortfolio]);
+
+  return {
+    identity,
+    portfolio,
+    isLoading,
+    error,
+    refresh: fetchPortfolio,
+    selectWorkspace,
+  };
+};
