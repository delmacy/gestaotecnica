@@ -0,0 +1,65 @@
+import { BuilderPortfolio, OrganizationPortfolio, PortfolioWorkspace } from './workspace-portfolio.types';
+
+export class BuilderPortfolioService {
+  async getBuilderPortfolio(userId: string): Promise<BuilderPortfolio> {
+    const response = await fetch(`/api/builder/portfolio`, {
+      credentials: 'include',
+      headers: {
+        'Cache-Control': 'no-cache',
+      },
+    });
+
+    if (!response.ok) {
+      throw new Error(`Failed to fetch portfolio: ${response.statusText}`);
+    }
+
+    const result = await response.json();
+    return result.data;
+  }
+
+  async selectWorkspace(userId: string, workspaceId: string): Promise<void> {
+    const response = await fetch(`/api/builder/portfolio`, {
+      method: 'POST',
+      credentials: 'include',
+      headers: {
+        'Content-Type': 'application/json',
+      },
+      body: JSON.stringify({ workspaceId }),
+    });
+
+    if (!response.ok) {
+      throw new Error(`Failed to select workspace: ${response.statusText}`);
+    }
+  }
+
+  getDisplayName(identity: { name: string; email: string; accessProfile: string }): string {
+    return identity.name || identity.email || 'Unknown Builder';
+  }
+
+  formatOrganizationName(org: OrganizationPortfolio): string {
+    return org.name || org.key || 'Unnamed Organization';
+  }
+
+  formatWorkspaceName(workspace: PortfolioWorkspace): string {
+    return workspace.name || workspace.key || 'Unnamed Workspace';
+  }
+
+  isWorkspaceSelected(workspace: PortfolioWorkspace): boolean {
+    return workspace.isSelected || false;
+  }
+
+  getTotalWorkspaceCount(organizations: OrganizationPortfolio[]): number {
+    return organizations.reduce((sum, org) => sum + org.workspaces.length, 0);
+  }
+
+  getSelectedWorkspace(organizations: OrganizationPortfolio[]): PortfolioWorkspace | null {
+    for (const org of organizations) {
+      for (const workspace of org.workspaces) {
+        if (workspace.isSelected) {
+          return workspace;
+        }
+      }
+    }
+    return null;
+  }
+}
