+export interface BuilderIdentity {
+  userId: string;
+  name: string;
+  email: string;
+  accessProfile: "builder" | "admin" | "operador";
+}
+
+export interface PortfolioWorkspace {
+  id: string;
+  key: string;
+  name: string;
+  adaptationKey: string | null;
+  organizationId: string;
+  organizationName: string;
+  organizationKey: string;
+  role: "workspace_member" | "workspace_admin" | "platform_admin";
+  isSelected: boolean;
+}
+
+export interface OrganizationPortfolio {
+  id: string;
+  key: string;
+  name: string;
+  workspaces: PortfolioWorkspace[];
+}
+
+export interface BuilderPortfolio {
+  identity: BuilderIdentity;
+  selectedWorkspaceId: string | null;
+  organizations: OrganizationPortfolio[];
+}
