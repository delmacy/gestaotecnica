+import React from 'react';
+import { useBuilderPortfolio } from './use-builder-portfolio';
+import { BuilderPortfolioService } from './workspace-portfolio.service';
+
+interface WorkspacePortfolioProps {
+  className?: string;
+  onWorkspaceSelect?: (workspaceId: string) => void;
+  userId?: string;
+}
+
+export const WorkspacePortfolio: React.FC<WorkspacePortfolioProps> = ({
+  className,
+  onWorkspaceSelect,
+  userId,
+}) => {
+  const { identity, portfolio, isLoading, error, selectWorkspace } = useBuilderPortfolio(userId);
+  const service = new BuilderPortfolioService();
+
+  if (isLoading) {
+    return (
+      <div className={className}>
+        <div className="flex justify-center items-center py-8">
+          <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
+        </div>
+      </div>
+    );
+  }
+
+  if (error) {
+    return (
+      <div className={className}>
+        <div className="bg-red-50 border border-red-200 rounded-md p-4">
+          <div className="text-red-800">Error: {error}</div>
+        </div>
+      </div>
+    );
+  }
+
+  if (!portfolio || !identity) {
+    return (
+      <div className={className}>
+        <div className="bg-gray-50 border border-gray-200 rounded-md p-4">
+          <div className="text-gray-600">No portfolio data available</div>
+        </div>
+      </div>
+    );
+  }
+
+  const displayName = service.getDisplayName(identity);
+  const totalWorkspaces = service.getTotalWorkspaceCount(portfolio.organizations);
+  const selectedWorkspace = service.getSelectedWorkspace(portfolio.organizations);
+
+  return (
+    <div className={`space-y-6 ${className || ''}`.trim()}>
+      <header className="bg-white border-b border-gray-200 px-6 py-4">
+        <div className="flex justify-between items-center">
+          <div>
+            <h1 className="text-2xl font-bold text-gray-900">Builder Dashboard</h1>
+            <p className="text-gray-600 mt-1">
+              Welcome, {displayName} - {service.getDisplayName(identity)}
+            </p>
+          </div>
+          <div className="text-right">
+            <div className="text-sm text-gray-500">Total Workspaces</div>
+            <div className="text-xl font-semibold text-blue-600">
+              {totalWorkspaces}
+            </div>
+          </div>
+        </div>
+      </header>
+
+      <main className="px-6 py-8">
+        {selectedWorkspace && (
+          <div className="bg-blue-50 border-l-4 border-blue-400 p-4 mb-6">
+            <div className="flex items-center">
+              <div className="flex-shrink-0">
+                <div className="w-2 h-2 bg-blue-400 rounded-full"></div>
+              </div>
+              <div className="ml-3">
+                <p className="text-sm text-blue-700">
+                  <span className="font-medium">Currently Selected:</span>{' '}
+                  {service.formatWorkspaceName(selectedWorkspace)}
+                </p>
+              </div>
+            </div>
+          </div>
+        )}
+
+        <div className="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
+          {portfolio.organizations.map((org) => (
+            <OrganizationCard
+              key={org.id}
+              organization={org}
+              onWorkspaceSelect={onWorkspaceSelect}
+              service={service}
+            />
+          ))}
+        </div>
+      </main>
+    </div>
+  );
+};
+
+interface OrganizationCardProps {
+  organization: OrganizationPortfolio;
+  onWorkspaceSelect?: (workspaceId: string) => void;
+  service: BuilderPortfolioService;
+}
+
+const OrganizationCard: React.FC<OrganizationCardProps> = ({
+  organization,
+  onWorkspaceSelect,
+  service,
+}) => {
+  const handleWorkspaceClick = (workspace: PortfolioWorkspace) => {
+    if (onWorkspaceSelect && !workspace.isSelected) {
+      onWorkspaceSelect(workspace.id);
+    }
+  };
+
+  return (
+    <div className="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
+      <div className="bg-gray-50 px-4 py-3 border-b border-gray-200">
+        <h3 className="font-semibold text-gray-900">
+          {service.formatOrganizationName(organization)}
+        </h3>
+        <p className="text-sm text-gray-500 mt-1">
+          {organization.workspaces.length} workspace
+          {organization.workspaces.length !== 1 ? 's' : ''}
+        </p>
+      </div>
+
+      <div className="p-4">
+        <div className="space-y-2">
+          {organization.workspaces.map((workspace) => (
+            <WorkspaceItem
+              key={workspace.id}
+              workspace={workspace}
+              onSelect={handleWorkspaceClick}
+              service={service}
+            />
+          ))}
+        </div>
+      </div>
+    </div>
+  );
+};
+
+interface WorkspaceItemProps {
+  workspace: PortfolioWorkspace;
+  onSelect: (workspace: PortfolioWorkspace) => void;
+  service: BuilderPortfolioService;
+}
+
+const WorkspaceItem: React.FC<WorkspaceItemProps> = ({
+  workspace,
+  onSelect,
+  service,
+}) => {
+  const isSelected = service.isWorkspaceSelected(workspace);
+
+  return (
+    <div
+      className={`p-3 rounded-md border transition-all cursor-pointer ${isSelected
+        ? 'bg-blue-50 border-blue-200 shadow-sm'
+        : 'bg-white border-gray-200 hover:bg-gray-50'
+      }`}
+      onClick={() => onSelect(workspace)}
+    >
+      <div className="flex items-center justify-between">
+        <div className="flex-1">
+          <div className="font-medium text-gray-900">
+            {service.formatWorkspaceName(workspace)}
+          </div>
+          <div className="text-sm text-gray-500 mt-1">
+            Key: {workspace.key}
+          </div>
+        </div>
+
+        {isSelected && (
+          <div className="ml-3">
+            <div className="bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded-full">
+              Selected
+            </div>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
