{
  "name": "gestaotecnica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "agent-work:db:check": "npx tsx src/agent-work/cli/index.ts db:check",
    "agent-work:dry-run": "npx tsx src/agent-work/cli/index.ts dry-run",
    "agent-work": "npx tsx src/agent-work/cli/index.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:architecture": "npx tsx scripts/validate-architecture-rules.ts",
    "check:no-explicit-any": "npx tsx scripts/check-explicit-any.ts",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "npx tsx --test tests/unit/*.test.ts",
    "test:integration": "npx tsx --test tests/integration/*.test.ts",
    "test:agent-work": "NODE_ENV=test npx tsx --test tests/integration/agent-work-*.test.ts",
    "test:agent-work:unit": "npx tsx --test tests/unit/agent-work-*.test.ts",
    "test:agent-work:integration": "npx tsx --test tests/integration/agent-work-operational-proof.test.ts",
    "test:agent-work:launch": "npx tsx --test tests/integration/agent-work-launch.test.ts",
    "test:e2e": "playwright test",
    "db:bootstrap": "npx tsx src/scripts/bootstrap-schemas.ts",
    "db:setup:unified-test": "npx tsx src/scripts/setup-unified-test-database.ts",
    "db:validate": "npx tsx src/scripts/db/validate-migrations.ts",
    "db:migrate": "npm run db:bootstrap && npm run db:validate && drizzle-kit push",
    "db:generate": "npm run db:bootstrap && drizzle-kit generate",
    "db:push": "npm run db:bootstrap && drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:golden-e2e": "npx tsx src/scripts/golden-e2e/seed.ts",
    "db:seed:golden-e2e:clean": "npx tsx src/scripts/golden-e2e/clean.ts",
    "db:seed:launch-demo": "npx tsx src/scripts/launch-demo/seed.ts",
    "db:seed:launch-demo:clean": "npx tsx src/scripts/launch-demo/clean.ts",
    "db:seed:launch-alpha": "npx tsx src/scripts/launch-alpha/seed.ts",
    "db:seed:launch-alpha:clean": "npx tsx src/scripts/launch-alpha/clean.ts",
    "test:golden-e2e": "npx tsx --test tests/integration/golden-cycle.test.ts",
    "db:preflight": "npx tsx src/scripts/db/preflight-env-binding.ts",
    "db:verify-ci": "npx tsx src/scripts/db/verify-schema-ci.ts",
    "db:migrate-ci": "npx drizzle-kit migrate",
    "db:setup-roles": "npx tsx src/scripts/db/setup-roles.ts",
    "db:bootstrap:full": "npx tsx src/scripts/bootstrap-full.ts",
    "db:break-glass:teardown": "npx tsx src/scripts/db/break-glass-teardown.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-swagger-doc": "^0.4.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.76.1",
    "swagger-ui-react": "^5.32.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/proxyquire": "^1.3.31",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/swagger-ui-react": "^5.18.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "proxyquire": "^2.1.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}